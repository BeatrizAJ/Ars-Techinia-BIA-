            "format": "int32"
          },
          "quantidadeDivisoes": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "quantidadeEquipamentos": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "quantidadeRecursosDidaticos": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CriarReservaDTO": {
        "required": [
          "dataHoraFim",
          "dataHoraInicio",
          "finalidade",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "idLocal": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "titulo": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "finalidade": {
            "maxLength": 500,
            "minLength": 5,
            "type": "string"
          },
          "dataHoraInicio": {
            "type": "string",
            "format": "date-time"
          },
          "dataHoraFim": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CriarUsuarioDTO": {
        "required": [
          "email",
          "idPapel",
          "nome",
          "senha"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          },
          "idPapel": {
            "pattern": "^(2|4)$",
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DecidirReservaDTO": {
        "required": [
          "acao"
        ],
        "type": "object",
        "properties": {
          "acao": {
            "minLength": 1,
            "pattern": "^(Aprovar|Rejeitar|Cancelar)$",
            "type": "string"
          },
          "observacaoDecisao": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
