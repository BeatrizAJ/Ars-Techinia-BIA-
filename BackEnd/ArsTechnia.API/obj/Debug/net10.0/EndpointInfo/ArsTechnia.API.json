  "components": {
    "schemas": {
      "AtualizarLocalDTO": {
        "required": [
          "capacidadePessoas",
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "capacidadePessoas": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantidadeDivisoes": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
